{
	"productName": "password-keeper",
	"version": "3.2.0",
	"identifier": "com.password-keeper.app",
	"build": {
		"beforeDevCommand": "pnpm dev",
		"devUrl": "http://localhost:1420",
		"beforeBuildCommand": "pnpm build",
		"frontendDist": "../dist"
	},
	"app": {
		"windows": [
			{
				"title": "Password Keeper",
				"minWidth": 1050,
				"minHeight": 600,
				"width": 1150,
				"height": 700,
				"decorations": false,
				"backgroundColor": "#23272A"
			}
		],
		"security": {
			"csp": null
		}
	},
	"bundle": {
		"createUpdaterArtifacts": true,
